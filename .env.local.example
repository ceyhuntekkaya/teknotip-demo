# Ollama — uzak sunucu (HTTPS) veya yerel
# Kök adres yeter; /api/chat yazılmaz.
OLLAMA_URL=https://chat.genixo.ai
OLLAMA_MODEL=qwen2.5:14b

# HTTP Basic Auth (uzak sunucu için zorunlu). Git'e commit etme.
OLLAMA_BASIC_USER=
OLLAMA_BASIC_PASS=

# Parolada #, " veya boşluk varsa USER/PASS yerine bunu kullan:
# echo -n 'USER:PASS' | base64
# OLLAMA_BASIC_AUTH_B64=

# İstek başına değiştirme; sunucu modelini yeniden yükletir.
OLLAMA_NUM_CTX=12288

# Uzun cevaplar için istemci zaman aşımı (ms)
OLLAMA_TIMEOUT_MS=300000

# Yerel Ollama için örnek:
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_BASIC_USER ve OLLAMA_BASIC_PASS boş bırakılabilir.

# STT (Whisper) — tarayıcı kaydını yazıya çevirir. Ses dosyası saklanmaz.
STT_URL=https://speaking.stt.eltaexams.com
STT_LANGUAGE=tr
# Dil otomatik algılansın diye boş bırakın: STT_LANGUAGE=
# STT_TIMEOUT_MS=120000
